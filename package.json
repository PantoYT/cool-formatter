{
	"name": "opspace",
	"version": "0.1.0",
	"private": true,
	"description": "Precedence-aware operator spacing for C-family languages: 2*a + 2*b, (a+b)*(a-b), x>0 && y<10",
	"type": "module",
	"bin": {
		"opspace": "src/cli.ts"
	},
	"scripts": {
		"test": "node src/cli.ts selftest",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22.18"
	},
	"dependencies": {
		"tree-sitter-c": "0.24.1",
		"tree-sitter-cpp": "0.23.4",
		"tree-sitter-php": "0.24.2",
		"web-tree-sitter": "0.27.2"
	},
	"devDependencies": {
		"@types/node": "26.6.10",
		"typescript": "7.0.2"
	}
}
