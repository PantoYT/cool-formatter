{
	"name": "cool-formatter",
	"displayName": "Cool Formatter™",
	"description": "Operator spacing that follows precedence, so code reads the way it binds.",
	"version": "0.4.0",
	"icon": "art/icon.png",
	"private": true,
	"publisher": "panto",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/PantoYT/cool-formatter"
	},
	"type": "module",
	"categories": [
		"Formatters"
	],
	"keywords": [
		"formatter",
		"operators",
		"spacing",
		"precedence",
		"php",
		"c",
		"cpp",
		"javascript",
		"typescript",
		"csharp",
		"java",
		"python",
		"rust",
		"tree-sitter"
	],
	"engines": {
		"vscode": "^1.90.0",
		"node": ">=22.18"
	},
	"main": "./dist/extension.cjs",
	"activationEvents": [
		"onLanguage:php",
		"onLanguage:c",
		"onLanguage:cpp",
		"onLanguage:javascript",
		"onLanguage:javascriptreact",
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:csharp",
		"onLanguage:java",
		"onLanguage:python",
		"onLanguage:rust"
	],
	"contributes": {
		"configuration": {
			"title": "Cool Formatter",
			"properties": {
				"coolFormatter.preset": {
					"type": "string",
					"enum": [
						"panto",
						"classic"
					],
					"enumDescriptions": [
						"2*a + 2*b, (a+b)*(a-b), x>0 && y<10, for (i=0; i<n; i++)",
						"a space around every operator, as Prettier and PSR-12 do"
					],
					"default": "panto",
					"description": "Spacing preset. A .cool-formatter.json next to the file or in a parent folder takes precedence."
				},
				"coolFormatter.baseFormatter": {
					"type": "string",
					"enum": [
						"auto",
						"extension",
						"none"
					],
					"enumDescriptions": [
						"Lay the document out first: JavaScript and TypeScript with VS Code's own formatting engine (javascript.format.* settings), other languages with their formatter extension (Intelephense, C/C++, ...)",
						"Always use the formatter extension VS Code offers for the language, Prettier included",
						"Only fix operator spacing"
					],
					"default": "auto",
					"description": "What happens before the operator spacing pass."
				}
			}
		}
	},
	"bin": {
		"cool-formatter": "src/cli.ts"
	},
	"scripts": {
		"test": "node src/cli.ts selftest",
		"typecheck": "tsc --noEmit",
		"build": "node scripts/build.js",
		"test:vscode": "node scripts/build.js && node test/vscode/run.js",
		"package": "node scripts/build.js && vsce package --no-dependencies",
		"vscode:prepublish": "node scripts/build.js"
	},
	"dependencies": {
		"tree-sitter-c": "0.24.1",
		"tree-sitter-c-sharp": "0.24.0",
		"tree-sitter-cpp": "0.23.4",
		"tree-sitter-java": "0.23.5",
		"tree-sitter-javascript": "0.25.0",
		"tree-sitter-php": "0.24.2",
		"tree-sitter-python": "0.25.0",
		"tree-sitter-rust": "0.24.0",
		"tree-sitter-typescript": "0.23.2",
		"typescript5": "npm:typescript@5.9.3",
		"web-tree-sitter": "0.27.2"
	},
	"devDependencies": {
		"@types/node": "26.6.10",
		"@types/vscode": "1.90.0",
		"@vscode/vsce": "4.1.1",
		"esbuild": "0.28.2",
		"ovsx": "1.4.0",
		"typescript": "7.0.2"
	}
}
